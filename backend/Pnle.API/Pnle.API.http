@Pnle.Api_HostAddress = http://localhost:5097

# Health check
GET {{Pnle.Api_HostAddress}}/healthz
Accept: application/json

###

# Login with Google ID token (sets pnle_refresh_token cookie)
POST {{Pnle.Api_HostAddress}}/auth/google
Content-Type: application/json

{
  "idToken": "YOUR_GOOGLE_ID_TOKEN"
}

###

# Refresh session (uses pnle_refresh_token cookie)
POST {{Pnle.Api_HostAddress}}/auth/refresh

###

# Logout (revokes the refresh token and clears the cookie)
POST {{Pnle.Api_HostAddress}}/auth/logout

###

# Current user (requires bearer token)
GET {{Pnle.Api_HostAddress}}/auth/me
Authorization: Bearer YOUR_ACCESS_TOKEN

###